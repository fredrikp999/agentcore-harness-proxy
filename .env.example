# Copy to .env (git-ignored) and fill in. Then: chmod 600 .env
# Never commit .env. More detail: "Finding the values for .env" in README.md

# --- clients/invoke_harness.py: calls the harness directly with your AWS credentials ---

# ARN of the AgentCore harness: arn:aws:bedrock-agentcore:<region>:<account-id>:harness/<harness-id>
# Find it in the AWS console: Amazon Bedrock AgentCore -> your harness -> copy its ARN.
# Your account id: aws sts get-caller-identity --query Account --output text
HARNESS_ARN=arn:aws:bedrock-agentcore:<region>:<account-id>:harness/<harness-id>

# --- clients/invoke_proxy.py: calls the harness through the Cloudflare Access proxy ---

# The proxy's public hostname, with https:// and a trailing slash. It is the hostname of
# the Cloudflare Access application and of the Worker's custom domain (the "routes"
# pattern in cloudflare/worker/wrangler.jsonc).
PROXY_URL=https://<your-hostname>/

# A Cloudflare Access service token. Zero Trust -> Access controls -> Service credentials
# -> Service Tokens -> Create. The Client ID ends in .access. The Client Secret is shown
# only once when you create the token; if you lose it, use "Refresh" to get a new one.
# The token only works if a policy with the action "Service Auth" on the Access
# application includes it.
CF_ACCESS_CLIENT_ID=<client-id>.access
CF_ACCESS_CLIENT_SECRET=<client-secret>
