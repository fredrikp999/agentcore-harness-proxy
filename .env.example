# Copy to .env (git-ignored) and fill in. Then: chmod 600 .env

# invoke_harness.py: the harness to call directly with your AWS credentials
HARNESS_ARN=arn:aws:bedrock-agentcore:<region>:<account-id>:harness/<harness-id>

# invoke_proxy.py: the Cloudflare Access proxy and its service token
PROXY_URL=https://<your-hostname>/
CF_ACCESS_CLIENT_ID=<client-id>.access
CF_ACCESS_CLIENT_SECRET=<client-secret>
